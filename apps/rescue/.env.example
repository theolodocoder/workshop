NEXT_PUBLIC_BEFORE_URL=http://localhost:4311
BEFORE_SUPABASE_URL=http://127.0.0.1:54421
# The before project's OWN public (anon) key. Locally it's the same CLI demo key; deployed it differs.
BEFORE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
